        <mxCell id="bqwYIzJOsD30StmWxQeE-3" parent="bqwYIzJOsD30StmWxQeE-5" style="text;html=1;whiteSpace=wrap;overflow=hidden;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fillColor=#FFFFFF;strokeColor=#E74C3C;" value="&lt;b style=&quot;color: rgb(231, 76, 60);&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;↩️ Undo 旧版本 V1&lt;/font&gt;&lt;/b&gt;&lt;table border=&quot;1&quot; style=&quot;border-collapse: collapse; width: 100%; margin-top: 4px; font-size: 11px; color: rgb(0, 0, 0); border: 1px solid rgb(231, 76, 60);&quot;&gt;&lt;tbody&gt;&lt;tr style=&quot;background-color: rgb(250, 219, 216);&quot;&gt;&lt;th style=&quot;padding:4px;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;name&lt;/font&gt;&lt;/th&gt;&lt;th style=&quot;padding:4px;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;DB_TRX_ID&lt;/font&gt;&lt;/th&gt;&lt;th style=&quot;padding:4px;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;DB_ROLL_PTR&lt;/font&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;text-align:center;&quot;&gt;&lt;td style=&quot;padding:4px;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;张三&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;100&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;color: gray; padding: 4px;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;NULL&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
