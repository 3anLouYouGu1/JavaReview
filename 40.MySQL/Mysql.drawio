        </mxCell>
        <mxCell id="vy14orGzfg-_qZtaTHTE-27" parent="X0c7wbbVCDjRiInCCg-K-3" style="rounded=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;whiteSpace=wrap;html=1;fillColor=#A29BFE;strokeColor=#6C5CE7;fontColor=#000000;fontStyle=1;fontSize=16;fontFamily=Comic Sans MS;" value="📝 EXPLAIN 剖析" vertex="1">
          <mxGeometry height="45" width="470" as="geometry" />
        </mxCell>
        <mxCell id="vy14orGzfg-_qZtaTHTE-29" parent="X0c7wbbVCDjRiInCCg-K-3" style="rounded=1;sketch=1;html=1;hachureGap=4;jiggle=2;curveFitting=1;whiteSpace=wrap;fillColor=#E0F7FA;strokeColor=#00CEC9;fontColor=#000000;align=left;spacingLeft=8;fontSize=11;fontFamily=Comic Sans MS;" value="&lt;font face=&quot;Comic Sans MS&quot;&gt;&lt;b style=&quot;font-size: 13px; color: rgb(0, 206, 201);&quot;&gt;🔍 1.EXPLAIN 调优&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#00cec9&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;color: green; font-weight: bold;&quot;&gt;system &amp;gt; const &amp;gt; eq_ref &amp;gt; ref &amp;gt; range &amp;gt; index &amp;gt; ALL&lt;/span&gt;&lt;br&gt;• &lt;b&gt;const:&lt;/b&gt; 主键或唯一索引等值查询，仅匹配 1 行&lt;br&gt;• &lt;b&gt;eq_ref:&lt;/b&gt; 多表 Join 时主键或唯一索引关联&lt;br&gt;• &lt;b&gt;ref:&lt;/b&gt; 非唯一索引等值扫描&lt;br&gt;• &lt;b&gt;range:&lt;/b&gt; 索引范围扫描 (IN, BETWEEN, &amp;gt;, &amp;lt;)&lt;br&gt;• &lt;b&gt;ALL:&lt;/b&gt; 性能最差，全表扫描！&lt;br&gt;&lt;hr&gt;&lt;b&gt;⚠️ &lt;font style=&quot;font-size: 13px; color: rgb(0, 206, 201);&quot;&gt;2. &lt;/font&gt;&lt;font style=&quot;font-size: 13px; color: rgb(0, 206, 201);&quot;&gt;Extra 关键提示标识&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#00cec9&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;• &lt;b style=&quot;color: green;&quot;&gt;Using index:&lt;/b&gt; 覆盖索引，无需回表聚簇索引！&lt;br&gt;• &lt;b style=&quot;color: orange;&quot;&gt;Using index condition:&lt;/b&gt; 索引下推 (ICP) 优化&lt;br&gt;• &lt;b style=&quot;color: red;&quot;&gt;Using filesort:&lt;/b&gt; 无法利用索引排序，需要额外的内存/磁盘排序 (需优化)&lt;br&gt;• &lt;b style=&quot;color: red;&quot;&gt;Using temporary:&lt;/b&gt; 使用了临时表 (常见于 GROUP BY / DISTINCT，需重点优化)&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="470" y="60" as="geometry" />
        </mxCell>
        <mxCell id="bqwYIzJOsD30StmWxQeE-7" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="245" width="400" x="2500" y="100" as="geometry" />
        </mxCell>
        <mxCell id="vy14orGzfg-_qZtaTHTE-17" parent="bqwYIzJOsD30StmWxQeE-7" style="rounded=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;whiteSpace=wrap;html=1;fillColor=#FFBE76;strokeColor=#F0932B;fontColor=#000000;fontStyle=1;fontSize=16;fontFamily=Comic Sans MS;" value="🔒 隔离级别与并发四大问题矩阵" vertex="1">
          <mxGeometry height="45" width="400" y="200" as="geometry" />
        </mxCell>
        <mxCell id="vy14orGzfg-_qZtaTHTE-18" parent="bqwYIzJOsD30StmWxQeE-7" style="text;html=1;whiteSpace=wrap;overflow=hidden;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fillColor=#FFFFFF;strokeColor=#F0932B;" value="&lt;table border=&quot;1&quot; style=&quot;border-collapse:collapse;width:100%;height:100%;font-family:Comic Sans MS;text-align:center;vertical-align:middle;font-size:12px;color:#000;border:1px solid #F0932B;&quot;&gt;&lt;tr style=&quot;background-color:#FFEAA7;&quot;&gt;&lt;th style=&quot;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;隔离级别&lt;/th&gt;&lt;th style=&quot;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;脏读&lt;/th&gt;&lt;th style=&quot;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;不可重复读&lt;/th&gt;&lt;th style=&quot;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;幻读&lt;/th&gt;&lt;th style=&quot;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;丢失更新&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px;font-weight:bold;text-align:center;vertical-align:middle;&quot;&gt;Read Uncommitted&lt;/td&gt;&lt;td style=&quot;color:#D63031;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;❌ 存在&lt;/td&gt;&lt;td style=&quot;color:#D63031;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;❌ 存在&lt;/td&gt;&lt;td style=&quot;color:#D63031;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;❌ 存在&lt;/td&gt;&lt;td style=&quot;color:#D63031;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;❌ 存在&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#FAFAFA;&quot;&gt;&lt;td style=&quot;padding:8px;font-weight:bold;text-align:center;vertical-align:middle;&quot;&gt;Read Committed&lt;/td&gt;&lt;td style=&quot;color:#00B894;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;✅ 解决&lt;/td&gt;&lt;td style=&quot;color:#D63031;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;❌ 存在&lt;/td&gt;&lt;td style=&quot;color:#D63031;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;❌ 存在&lt;/td&gt;&lt;td style=&quot;color:#D63031;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;❌ 存在&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#E8F8F5;&quot;&gt;&lt;td style=&quot;padding:8px;font-weight:bold;text-align:center;vertical-align:middle;&quot;&gt;Repeatable Read&lt;/td&gt;&lt;td style=&quot;color:#00B894;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;✅ 解决&lt;/td&gt;&lt;td style=&quot;color:#00B894;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;✅ 解决&lt;/td&gt;&lt;td style=&quot;color:#00B894;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;✅ 解决&lt;/td&gt;&lt;td style=&quot;color:#00B894;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;✅ 解决&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#FAFAFA;&quot;&gt;&lt;td style=&quot;padding:8px;font-weight:bold;text-align:center;vertical-align:middle;&quot;&gt;Serializable&lt;/td&gt;&lt;td style=&quot;color:#00B894;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;✅ 解决&lt;/td&gt;&lt;td style=&quot;color:#00B894;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;✅ 解决&lt;/td&gt;&lt;td style=&quot;color:#00B894;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;✅ 解决&lt;/td&gt;&lt;td style=&quot;color:#00B894;padding:8px;text-align:center;vertical-align:middle;&quot;&gt;✅ 解决&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="180" width="400" as="geometry" />
        </mxCell>
        <mxCell id="oZOOYCKAifwTlRQEU5Wi-9" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="370" width="1760" x="2780" y="2170" as="geometry" />
        </mxCell>
        <mxCell id="oZOOYCKAifwTlRQEU5Wi-2" parent="oZOOYCKAifwTlRQEU5Wi-9" style="rounded=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;whiteSpace=wrap;html=1;fillColor=#A29BFE;strokeColor=#6C5CE7;fontColor=#000000;fontStyle=1;fontSize=16;fontFamily=Comic Sans MS;" value="📝 7. 索引优化全集：失效场景 + B+Tree 页分裂 + Join 机制" vertex="1">
          <mxGeometry height="45" width="1750" x="10" as="geometry" />
        </mxCell>
        <mxCell id="oZOOYCKAifwTlRQEU5Wi-3" parent="oZOOYCKAifwTlRQEU5Wi-9" style="rounded=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;whiteSpace=wrap;html=1;fillColor=#FFEAA7;strokeColor=#F1C40F;fontColor=#000000;align=left;spacingLeft=10;fontSize=11;fontFamily=Comic Sans MS;" value="&lt;b style=&quot;color: rgb(214, 48, 49);&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;⚠️ 索引失效典型场景&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;font color=&quot;#d63031&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;1. &lt;b&gt;违反最左前缀法则：&lt;/b&gt;联合索引 (a,b,c)，直接跳过 a 使用 WHERE b=1 AND c=2&lt;br&gt;2. &lt;b&gt;隐式类型转换：&lt;/b&gt;varchar 字符串列传入 int 值 (WHERE phone=138000)&lt;br&gt;3. &lt;b&gt;索引列函数/表达式运算：&lt;/b&gt;WHERE YEAR(create_time)=2026 或 WHERE age+1=18&lt;br&gt;4. &lt;b&gt;范围查询断开后续索引：&lt;/b&gt;WHERE a=1 AND b&amp;gt;10 AND c=3 (c 列走不了索引)&lt;br&gt;5. &lt;b&gt;模糊查询前导通配符：&lt;/b&gt;WHERE name LIKE &#39;%三&#39; (后置通配符 &#39;三%&#39; 可以走索引)&lt;br&gt;6. &lt;b&gt;OR 连接未带索引列：&lt;/b&gt;WHERE id=1 OR age=18 (若 age 无索引则整个语句全表扫描)&lt;br&gt;7. &lt;b&gt;两表字符集不一致：&lt;/b&gt;Join 关联列字符集不匹配 (utf8 与 utf8mb4 发生隐式转换)&lt;br&gt;8. &lt;b&gt;优化器成本估算偏差：&lt;/b&gt;数据量极小或统计信息不准，MySQL 认为全表扫描更快&lt;br&gt;9. &lt;b&gt;IS NULL / IS NOT NULL：&lt;/b&gt;根据 NULL 占比评估，非空占比极高时 IS NOT NULL 失效&lt;br&gt;10. &lt;b&gt;不等于符号使用：&lt;/b&gt;WHERE age != 20 或 &amp;lt;&amp;gt; 可能会导致优化器放弃索引&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="550" y="120" as="geometry" />
        </mxCell>
        <mxCell id="oZOOYCKAifwTlRQEU5Wi-4" parent="oZOOYCKAifwTlRQEU5Wi-9" style="rounded=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#1DD1A1;fontColor=#000000;align=left;spacingLeft=10;fontSize=11;fontFamily=Comic Sans MS;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;color: rgb(51, 255, 255);&quot;&gt;🌳&lt;/b&gt;&lt;b style=&quot;color: rgb(0, 204, 204);&quot;&gt; B+Tree 节点页分裂与合并原理&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. 页分裂 (Page Split):&lt;/b&gt;&lt;br&gt;• 场景：数据页 (默认 16KB) 已装满，插入随机主键 (如 UUID) 乱序写入&lt;br&gt;• 过程：寻找合适位置 ➔ 申请新数据页 ➔ 将原页 50% 数据移动至新页 ➔ 更新上层目录页指针&lt;br&gt;• 影响：引发大量物理随机 I/O、占用额外空间、产生页碎片（推荐单调自增主键）&lt;br&gt;&lt;br&gt;&lt;b&gt;2. 页合并 (Page Merge):&lt;/b&gt;&lt;br&gt;• 场景：频繁 DELETE 删除数据或 UPDATE 变更，导致页利用率低于阈值 (MERGE_THRESHOLD 默认 50%)&lt;br&gt;• 过程：查看前后相邻节点数据页 ➔ 尝试将碎片数据合并进一个数据页 ➔ 释放空页" vertex="1">
          <mxGeometry height="250" width="550" x="610" y="120" as="geometry" />
        </mxCell>
        <mxCell id="oZOOYCKAifwTlRQEU5Wi-5" parent="oZOOYCKAifwTlRQEU5Wi-9" style="rounded=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#8E24AA;fontColor=#000000;align=left;spacingLeft=10;fontSize=11;fontFamily=Comic Sans MS;" value="&lt;b&gt;🔗&lt;span style=&quot;color: rgb(153, 51, 255);&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt; Join 关联查询底层 3 大执行机制&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Index Nested-Loop Join (INLJ - 索引嵌套循环):&lt;/b&gt;&lt;br&gt;驱动表全表扫描，被驱动表关联列【有索引】。每次匹配直接走 B+Tree 索引查找，性能最高！&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Block Nested-Loop Join (BNLJ - 块嵌套循环):&lt;/b&gt;&lt;br&gt;被驱动表关联列【无索引】。将驱动表分批拉入内存 &lt;b style=&quot;color: rgb(214, 48, 49);&quot;&gt;Join Buffer&lt;/b&gt;，批量与被驱动表扫描比对，降低磁盘扫描次数。&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Simple Nested-Loop Join (SNLJ - 简单嵌套循环):&lt;/b&gt;&lt;br&gt;无索引且无 Join Buffer，双重 Nested Loop 匹配，开销等于 M×N 行扫描，MySQL 8.0 已用 Hash Join 彻底替代它。" vertex="1">
          <mxGeometry height="250" width="550" x="1210" y="120" as="geometry" />
        </mxCell>
        <mxCell id="oZOOYCKAifwTlRQEU5Wi-6" edge="1" parent="oZOOYCKAifwTlRQEU5Wi-9" source="oZOOYCKAifwTlRQEU5Wi-2" style="edgeStyle=orthogonalEdgeStyle;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;strokeColor=#6C5CE7;endArrow=classic;endSize=8;strokeWidth=2;" target="oZOOYCKAifwTlRQEU5Wi-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="oZOOYCKAifwTlRQEU5Wi-7" edge="1" parent="oZOOYCKAifwTlRQEU5Wi-9" source="oZOOYCKAifwTlRQEU5Wi-2" style="edgeStyle=orthogonalEdgeStyle;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;strokeColor=#6C5CE7;endArrow=classic;endSize=8;strokeWidth=2;" target="oZOOYCKAifwTlRQEU5Wi-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
