        <mxCell id="9OhNDfNVqfDzwNlpcM6--17" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fillColor=#FFFFFF;strokeColor=#F0932B;" value="&lt;table border=&quot;1&quot; style=&quot;border-collapse:collapse;width:100%;font-family:Comic Sans MS;text-align:center;font-size:12px;color:#000;border:1px solid #F0932B;&quot;&gt;&lt;tr style=&quot;background-color:#FFEAA7;&quot;&gt;&lt;th style=&quot;padding:8px;&quot;&gt;隔离级别 (Level)&lt;/th&gt;&lt;th style=&quot;padding:8px;&quot;&gt;脏读 (Dirty Read)&lt;/th&gt;&lt;th style=&quot;padding:8px;&quot;&gt;不可重复读 (Non-Repeatable)&lt;/th&gt;&lt;th style=&quot;padding:8px;&quot;&gt;幻读 (Phantom Read)&lt;/th&gt;&lt;th style=&quot;padding:8px;&quot;&gt;丢失更新 (Lost Update)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:6px;font-weight:bold;&quot;&gt;Read Uncommitted&lt;/td&gt;&lt;td style=&quot;color:#D63031;padding:6px;&quot;&gt;❌ 存在&lt;/td&gt;&lt;td style=&quot;color:#D63031;padding:6px;&quot;&gt;❌ 存在&lt;/td&gt;&lt;td style=&quot;color:#D63031;padding:6px;&quot;&gt;❌ 存在&lt;/td&gt;&lt;td style=&quot;color:#D63031;padding:6px;&quot;&gt;❌ 存在&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#FAFAFA;&quot;&gt;&lt;td style=&quot;padding:6px;font-weight:bold;&quot;&gt;Read Committed&lt;/td&gt;&lt;td style=&quot;color:#00B894;padding:6px;&quot;&gt;✅ 解决&lt;/td&gt;&lt;td style=&quot;color:#D63031;padding:6px;&quot;&gt;❌ 存在&lt;/td&gt;&lt;td style=&quot;color:#D63031;padding:6px;&quot;&gt;❌ 存在&lt;/td&gt;&lt;td style=&quot;color:#D63031;padding:6px;&quot;&gt;❌ 存在&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#E8F8F5;&quot;&gt;&lt;td style=&quot;padding:6px;font-weight:bold;&quot;&gt;Repeatable Read (默认)&lt;/td&gt;&lt;td style=&quot;color:#00B894;padding:6px;&quot;&gt;✅ 解决&lt;/td&gt;&lt;td style=&quot;color:#00B894;padding:6px;&quot;&gt;✅ 解决&lt;/td&gt;&lt;td style=&quot;color:#00B894;padding:6px;&quot;&gt;✅ 解决 (MVCC+NextKey)&lt;/td&gt;&lt;td style=&quot;color:#00B894;padding:6px;&quot;&gt;✅ 解决&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#FAFAFA;&quot;&gt;&lt;td style=&quot;padding:6px;font-weight:bold;&quot;&gt;Serializable&lt;/td&gt;&lt;td style=&quot;color:#00B894;padding:6px;&quot;&gt;✅ 解决&lt;/td&gt;&lt;td style=&quot;color:#00B894;padding:6px;&quot;&gt;✅ 解决&lt;/td&gt;&lt;td style=&quot;color:#00B894;padding:6px;&quot;&gt;✅ 解决&lt;/td&gt;&lt;td style=&quot;color:#00B894;padding:6px;&quot;&gt;✅ 解决&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
