        </mxCell>
        <mxCell id="S7F0txDrejPJIbwdKUsG-57" parent="S7F0txDrejPJIbwdKUsG-54" style="text;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Architects Daughter;" value="标记整理" vertex="1">
