        <mxCell id="9ueeVht_JpacNWR-q-71-89" edge="1" parent="9ueeVht_JpacNWR-q-71-1" source="9ueeVht_JpacNWR-q-71-87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#27AE60;strokeWidth=3;sketch=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="9ueeVht_JpacNWR-q-71-88">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9ueeVht_JpacNWR-q-71-90" parent="9ueeVht_JpacNWR-q-71-1" style="text;html=1;strokeColor=#8E44AD;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;rounded=1;spacingLeft=10;spacingRight=10;sketch=1;fontFamily=Comic Sans MS;" value="写屏障机制：当黑色 D 新增对白色 G 的引用时，记录此新引用，将 D 退回变回灰色。" vertex="1">
          <mxGeometry height="45" width="555" x="1205" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="9ueeVht_JpacNWR-q-71-91" parent="9ueeVht_JpacNWR-q-71-1" style="text;html=1;strokeColor=none;fillColor=#D5E8D4;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;fontColor=#27AE60;spacingLeft=10;fontFamily=Comic Sans MS;" value="✅ 效果：重新标记阶段重新扫描变灰的 D，从而将 G 顺利标记为黑色。" vertex="1">
          <mxGeometry height="25" width="755" x="1005" y="1085" as="geometry" />
        </mxCell>
        <mxCell id="9ueeVht_JpacNWR-q-71-92" parent="9ueeVht_JpacNWR-q-71-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#E67E22;strokeWidth=1.5;sketch=1;fontFamily=Comic Sans MS;" value="" vertex="1">
          <mxGeometry height="160" width="790" x="985" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="9ueeVht_JpacNWR-q-71-93" parent="9ueeVht_JpacNWR-q-71-1" style="text;html=1;strokeColor=none;fillColor=#E67E22;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#ffffff;rounded=1;spacingLeft=10;fontFamily=Comic Sans MS;" value="方案 C：读屏障 Read Barrier（ZGC / Shenandoah）—— 读动作主动干预" vertex="1">
          <mxGeometry height="25" width="790" x="985" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="9ueeVht_JpacNWR-q-71-94" parent="9ueeVht_JpacNWR-q-71-1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#000000;strokeWidth=2;sketch=1;fontFamily=Comic Sans MS;" value="E (灰)" vertex="1">
          <mxGeometry height="35" width="60" x="1005" y="1180" as="geometry" />
        </mxCell>
        <mxCell id="9ueeVht_JpacNWR-q-71-95" parent="9ueeVht_JpacNWR-q-71-1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;sketch=1;fontFamily=Comic Sans MS;" value="G (白)" vertex="1">
          <mxGeometry height="35" width="60" x="1120" y="1180" as="geometry" />
        </mxCell>
        <mxCell id="9ueeVht_JpacNWR-q-71-96" edge="1" parent="9ueeVht_JpacNWR-q-71-1" source="9ueeVht_JpacNWR-q-71-94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;sketch=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="9ueeVht_JpacNWR-q-71-95">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9ueeVht_JpacNWR-q-71-97" parent="9ueeVht_JpacNWR-q-71-1" style="text;html=1;strokeColor=#E67E22;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;rounded=1;spacingLeft=10;spacingRight=10;sketch=1;fontFamily=Comic Sans MS;" value="读屏障机制：在应用程序尝试读取 G 引用时立即拦截，并瞬间将 G 标记为灰色存活对象。" vertex="1">
          <mxGeometry height="45" width="555" x="1205" y="1175" as="geometry" />
        </mxCell>
        <mxCell id="9ueeVht_JpacNWR-q-71-98" parent="9ueeVht_JpacNWR-q-71-1" style="text;html=1;strokeColor=none;fillColor=#D5E8D4;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;fontColor=#27AE60;spacingLeft=10;fontFamily=Comic Sans MS;" value="✅ 效果：直接在应用程序拿到引用时完成保护，绝对不给“漏标”留有余地。" vertex="1">
          <mxGeometry height="25" width="755" x="1005" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="9ueeVht_JpacNWR-q-71-99" parent="9ueeVht_JpacNWR-q-71-1" style="text;html=1;strokeColor=#2C3E50;fillColor=#D6EAF8;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;rounded=1;sketch=1;fontFamily=Comic Sans MS;" value="💡 终极总结：多标（浮动垃圾）无害仅浪费少许内存；漏标（误杀活跃对象）致命，必须使用【SATB写屏障】/【增量更新写屏障】/【读屏障】破坏漏标必备条件！" vertex="1">
          <mxGeometry height="45" width="1720" x="80" y="1345" as="geometry" />
        </mxCell>
        <mxCell id="zvBti3IYiBGVaYP6-cof-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;" value="&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Architects+Daughter&quot; face=&quot;Comic Sans MS&quot;&gt;&lt;b style=&quot;color: rgb(255, 51, 51);&quot;&gt;染色指针（Colored Pointers）&lt;/b&gt;。它通过在 64 位指针的未使用高位上&lt;br&gt;&lt;/font&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Architects+Daughter&quot; face=&quot;Comic Sans MS&quot;&gt;存储元数据（如标记和重映射状态），实现了元数据与对象本身的分离。&lt;/font&gt;&lt;blockquote style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;1. 并发标记 (Concurrent Mark)&amp;nbsp;&lt;br&gt;&lt;/font&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;ZGC 的并发标记阶段不修改对象头，而是修改指向对象的指针本身。&lt;/font&gt;&lt;/blockquote&gt;&lt;blockquote&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Comic Sans MS&amp;quot;; background-color: transparent;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2. &lt;/span&gt;&lt;b style=&quot;color: light-dark(rgb(255, 51, 51), rgb(255, 255, 255));&quot;&gt;读屏障 (Load Barrier) &lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;与“自愈”能力&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Comic Sans MS&amp;quot;; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;当应用线程通过一个被标记的指针去访问对象时，读屏障会介入。&lt;/span&gt;&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="330" width="720" x="-2100" y="-560" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
