        <mxCell id="KhyyGNtIl1cw1HzKV6B6-53" edge="1" parent="1" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=16;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
